<launch>
  <!-- .onnx 使用 ONNX Runtime，.engine 使用 TensorRT；也可在 roslaunch 命令行覆盖。 -->
  <node pkg="two_stream" type="ros_yolo_node" name="ros_yolo_node" output="screen">
    <param name="use_gpu" value="true"/>
    <param name="show_window" value="true"/>
    <param name="triangulate" value="false"/>
    <!-- true: Odometry 分别匹配 RGB/IR；false: 还要求匹配 LiDAR。 -->
    <param name="camera_only" value="false"/>

    <param name="model_path" value="$(find two_stream)/models/best-fp16.engine"/>
    <param name="class_names_path" value="$(find two_stream)/models/llvip.names"/>

    <param name="config_path" value="$(find two_stream)/config/config.yaml"/>
    <param name="model_dir" value="$(find two_stream)/weights"/>

    <param name="rgb_topic" value="/camera/color/image_raw"/>
    <param name="ir_topic" value="/pub_ir"/>
    <param name="lidar_topic" value="/cloud_undistorted"/>
    <param name="filtered_point_cloud_topic" value="/fusion/points_filtered"/>
    <!-- camera_init 下所选聚类簇的轴对齐包围盒及跟踪编号。 -->
    <param name="cluster_bounding_boxes_topic" value="/fusion/cluster_boxes"/>
    <param name="odometry_topic" value="/Odometry"/>
    <!-- 各传感器缓存及 Odometry 锚点队列的最大长度。 -->
    <param name="sync_queue_size" value="10"/>
    <param name="output_topic" value="/two_stream/image_annotated"/>

    <param name="input_width" value="640"/>
    <param name="input_height" value="640"/>
    <param name="conf_threshold" value="0.30"/>
    <param name="iou_threshold" value="0.40"/>
    <param name="cluster_tolerance" value="0.50"/>
    <param name="cluster_min_size" value="3"/>
    <param name="cluster_max_size" value="100000"/>
    <param name="track_buffer_seconds" value="3.0"/>
    <param name="world_measurement_timeout_seconds" value="3.0"/>
  </node>
</launch>
